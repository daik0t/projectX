# ── Локальная разработка ─────────────────────────────────────────────
# Адрес бэкенда для прокси Vite (читается из .env / .env.local).
# VITE_API_PROXY=http://localhost:8080

# Прямой URL REST API. Пусто = тот же origin (в dev — прокси Vite,
# в проде — reverse-proxy, отдающий /api на бэкенд).
# VITE_API_URL=http://localhost:8080

# Отдельный URL OAuth-эндпоинтов (/oauth2/authorization/...).
# Если не задан — используется VITE_API_URL.
# VITE_OAUTH_URL=http://localhost:8080

# Серверный oEmbed-прокси для платформ без прямого oEmbed.
# VITE_OEMBED_PROXY=http://localhost:8080/api/oembed

# ── Production (пример) ──────────────────────────────────────────────
# VITE_API_URL=https://api.example.com
# VITE_OAUTH_URL=https://api.example.com
# VITE_OEMBED_PROXY=https://api.example.com/api/oembed

# ── Согласование с бэкендом ──────────────────────────────────────────
# После OAuth бэкенд редиректит на app.oauth.frontend-url
# (по умолчанию http://localhost:5173), а CORS разрешает
# CORS_ALLOWED_ORIGINS (тоже http://localhost:5173).
# Если меняете порт фронтенда — обновите оба значения в projectx/.env.
